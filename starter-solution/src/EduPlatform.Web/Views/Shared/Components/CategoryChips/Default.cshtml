@* EduPlatform.Web/Views/Shared/Components/CategoryChips/Default.cshtml — Ch.14 HTMX flavor *@
@using EduPlatform.Web.ViewComponents
@model IReadOnlyList<CategoryChipVm>
<nav class="category-chips">
    @foreach (var chip in Model)
    {
        <a asp-controller="Home" asp-action="Index"
           asp-route-categorySlug="@chip.Slug"
           hx-get="@Url.Action("PopularGrid", "Home", new { categorySlug = chip.Slug })"
           hx-target="#popular-grid"
           hx-swap="innerHTML"
           hx-push-url="true"
           class="category-chip @(chip.IsActive ? "active" : "")">
            @chip.Name
        </a>
    }
</nav>
