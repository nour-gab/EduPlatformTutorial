{
  "version": "1.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "provider": "cdnjs",
      "library": "twitter-bootstrap@5.3.3",
      "destination": "wwwroot/lib/bootstrap",
      "files": [
        "css/bootstrap.min.css",
        "js/bootstrap.bundle.min.js"
      ]
    },
    {
      "provider": "cdnjs",
      "library": "jquery@3.7.1",
      "destination": "wwwroot/lib/jquery",
      "files": [ "jquery.min.js" ]
    },
    {
      "provider": "cdnjs",
      "library": "jquery-ajax-unobtrusive@3.2.6",
      "destination": "wwwroot/lib/jquery-ajax-unobtrusive",
      "files": [ "jquery.unobtrusive-ajax.min.js" ]
    },
    {
      "provider": "cdnjs",
      "library": "chart.js@4.4.2",
      "destination": "wwwroot/lib/chart.js",
      "files": [ "chart.umd.min.js" ]
    },
    {
      "provider": "cdnjs",
      "library": "bootstrap-icons@1.11.3",
      "destination": "wwwroot/lib/bootstrap-icons",
      "files": [ "font/bootstrap-icons.min.css" ]
    }
  ]
}
